{
  "configVersion": "1.0.0",
  "project": {
    "name": "Sentinel Optimizer",
    "slug": "sentinel-optimizer",
    "repository": "ninjapaw/sentinel-optimizer"
  },
  "defaults": {
    "deploymentTarget": "azure-static-web-app",
    "aiApiKeySecretName": "ai-api-key",
    "location": "centralus",
    "siteSku": "Free",
    "siteBase": "/",
    "functionMemoryMB": 512,
    "functionMaximumInstances": 40,
    "functionAlwaysReadyInstances": 0,
    "functionStorageSku": "Standard_LRS",
    "deployApi": true,
    "useApi": true,
    "enableAnonymousAiRoutes": false,
    "deployKeyVault": true,
    "deployOpenAi": false,
    "openAiModelName": "gpt-4.1-mini",
    "openAiModelDeployment": "sentinel-optimizer-model",
    "openAiDeploymentSku": "GlobalStandard",
    "openAiModelCapacity": 1,
    "secretExpirationDays": 365,
    "secretWarningDays": 30,
    "resolver": {
      "required": [
        "azureEnvironment",
        "staticWebAppName",
        "functionAppName",
        "customDomain",
        "publicSiteUrl"
      ],
      "envOverridable": ["PUBLIC_SITE_URL", "PUBLIC_SITE_BASE"],
      "env": {
        "DEPLOYMENT_TARGET": "deploymentTarget",
        "AZURE_AI_API_KEY_SECRET_NAME": "aiApiKeySecretName",
        "AZURE_STATIC_WEB_APP_NAME": "staticWebAppName",
        "AZURE_FUNCTIONAPP_NAME": "functionAppName",
        "AZURE_KEY_VAULT_NAME": "keyVaultName",
        "AZURE_OPENAI_ACCOUNT_NAME": "openAiAccountName",
        "AZURE_OPENAI_MODEL_NAME": "openAiModelName",
        "AZURE_OPENAI_MODEL_DEPLOYMENT": "openAiModelDeployment",
        "AZURE_OPENAI_DEPLOYMENT_SKU": "openAiDeploymentSku",
        "AZURE_OPENAI_MODEL_CAPACITY": "openAiModelCapacity",
        "AZURE_SITE_SKU": "siteSku",
        "AZURE_FUNCTION_INSTANCE_MEMORY_MB": "functionMemoryMB",
        "AZURE_FUNCTION_MAXIMUM_INSTANCE_COUNT": "functionMaximumInstances",
        "AZURE_FUNCTION_ALWAYS_READY_INSTANCES": "functionAlwaysReadyInstances",
        "AZURE_FUNCTION_STORAGE_SKU": "functionStorageSku",
        "AZURE_DEPLOY_API": "deployApi",
        "AZURE_USE_API": "useApi",
        "AZURE_ENABLE_ANONYMOUS_AI_ROUTES": "enableAnonymousAiRoutes",
        "AZURE_DEPLOY_KEY_VAULT": "deployKeyVault",
        "AZURE_DEPLOY_OPENAI": "deployOpenAi",
        "AZURE_CUSTOM_DOMAIN": "customDomain",
        "AZURE_PUBLIC_SITE_URL": "publicSiteUrl",
        "PUBLIC_SITE_URL": "publicSiteUrl",
        "PUBLIC_SITE_BASE": "siteBase",
        "AZURE_SECRET_EXPIRES_IN_DAYS": "secretExpirationDays",
        "AZURE_SECRET_WARN_DAYS": "secretWarningDays"
      }
    }
  },
  "environments": {
    "dev": {
      "branch": "dev",
      "githubEnvironment": "dev",
      "azureEnvironment": "development",
      "subscriptionId": "",
      "location": "centralus",
      "resourceGroup": "NP-SentinelOptimizer-Dev-CentralUS",
      "staticWebAppName": "np-sentineloptimizer-dev-centralus",
      "functionAppName": "np-sentineloptimizer-api-dev-centralus",
      "keyVaultName": "sentinel-opt-dev-kv",
      "openAiAccountName": "sentinel-opt-dev-openai",
      "customDomain": "dev.sentineloptimizer.com",
      "publicSiteUrl": "https://dev.sentineloptimizer.com",
      "secrets": {
        "mode": "workload",
        "vaultName": "sentinel-opt-dev-kv",
        "purgeProtection": true,
        "expirationDays": 365,
        "warningDays": 30
      }
    },
    "prod": {
      "branch": "main",
      "githubEnvironment": "prod",
      "azureEnvironment": "production",
      "subscriptionId": "",
      "location": "centralus",
      "resourceGroup": "NP-SentinelOptimizer-CentralUS",
      "staticWebAppName": "np-sentineloptimizer-centralus",
      "functionAppName": "np-sentineloptimizer-api-centralus",
      "keyVaultName": "sentinel-opt-prod-kv",
      "openAiAccountName": "sentinel-opt-openai",
      "customDomain": "sentineloptimizer.com",
      "publicSiteUrl": "https://sentineloptimizer.com",
      "secrets": {
        "mode": "workload",
        "vaultName": "sentinel-opt-prod-kv",
        "purgeProtection": true,
        "expirationDays": 365,
        "warningDays": 30
      }
    }
  }
}
