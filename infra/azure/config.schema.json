{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ninjapaw/sentinel-optimizer/main/infra/azure/config.schema.json",
  "title": "Sentinel Optimizer Azure infrastructure configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceGroup",
    "publicSiteUrl",
    "deployApi",
    "useApi",
    "staticWebAppName",
    "functionAppName",
    "oidc",
    "openAi"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "resourceGroup": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9._()\\-]+$"
    },
    "publicSiteUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\r\\n]+$"
    },
    "deployApi": {
      "type": "boolean",
      "default": false
    },
    "useApi": {
      "type": "boolean",
      "default": false
    },
    "staticWebAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "functionAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infrastructureApplicationName",
        "apiApplicationName"
      ],
      "properties": {
        "infrastructureApplicationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "apiApplicationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "openAi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountName",
        "modelName",
        "deploymentName"
      ],
      "properties": {
        "accountName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "modelName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "deploymentName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    }
  }
}
