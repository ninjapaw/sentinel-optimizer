# Public build configuration. These values are embedded into browser assets;
# do not put passwords, API keys, tokens, or tenant secrets here.
PUBLIC_SITE_URL=https://sentineloptimizer.com
PUBLIC_SITE_BASE=/
PUBLIC_SITE_NAME=Sentinel Optimizer
PUBLIC_SITE_TAGLINE=SIEM cost & migration estimator
PUBLIC_SITE_OWNER=Sentinel Optimizer contributors
PUBLIC_SITE_REPOSITORY=ninjapaw/sentinel-optimizer
PUBLIC_SITE_DESCRIPTION=Analyze SIEM ingestion, estimate Microsoft Sentinel cost, and get optimization recommendations entirely in your browser.

# Optional external API origins. Leave blank for same-origin API paths.
PUBLIC_AI_API_BASE=
PUBLIC_ADMIN_API_BASE=

# Optional External ID SPA configuration. These identifiers are public, not secrets.
PUBLIC_ENTRA_EXTERNAL_ID_CLIENT_ID=
PUBLIC_ENTRA_EXTERNAL_ID_AUTHORITY=
PUBLIC_ENTRA_EXTERNAL_ID_API_SCOPE=
PUBLIC_ENTRA_EXTERNAL_ID_ADMIN_ROLE=
