---
interface Props {
  title?: string;
  description?: string;
}

import Disclaimer from "../components/Disclaimer.astro";
import { BRAND } from "../lib/brand";
import { USER_CONFIG } from "@shared/index.js";

const {
  title = `${USER_CONFIG.site.name}${USER_CONFIG.site.titleSeparator}${USER_CONFIG.site.tagline}`,
  description = USER_CONFIG.site.defaultDescription,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html
  lang={USER_CONFIG.site.language}
  dir={USER_CONFIG.site.direction}
  data-theme="dark"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={BRAND.owner} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>

    <!-- No-FOUC: set the theme before first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- JSON-LD structured data for search engines and AI crawlers -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: BRAND.name,
      description: BRAND.tagline,
      url: siteUrl,
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Disclaimer />
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
