import Base from "../layouts/Base.astro";
import ThemeToggle from "../components/ThemeToggle.tsx";
import CalculatorTabs from "../components/CalculatorTabs.tsx";
import Footer from "../components/Footer.astro";
import { BRAND } from "../lib/brand.js";

const base = import.meta.env.BASE_URL;
const repositoryUrl = `https://github.com/${BRAND.repo}`;
---

<Base>
  <header class="site-header">
    <div class="container">
      <a class="brand" href={base}>
        <span class="dot"></span>
        {BRAND.name}
      </a>
      <div class="header-actions">
        <a class="btn btn-ghost btn-sm" href={repositoryUrl} rel="noopener">
          GitHub
        </a>
        <ThemeToggle client:load />
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero tool-hero">
      <div class="container">
        <span class="eyebrow">Security cost tools</span>
        <h1>Price Sentinel, compare SIEMs, and explain Defender savings.</h1>
        <p>
          A practical toolkit for non-technical planning conversations. Start with one number, paste an export when
          you have it, and keep every estimate traceable to the assumptions behind it.
        </p>
        <div class="badges">
          <span class="badge"><span class="ic">1</span> Enter volume</span>
          <span class="badge"><span class="ic">2</span> Compare cost</span>
          <span class="badge"><span class="ic">3</span> Export a clean report</span>
          <span class="badge"><span class="ic">✓</span> Browser-first</span>
        </div>
      </div>
    </section>

    <section class="tool-picker section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Choose a tool</span>
          <p class="section-help">Each tool starts simple and shows the assumptions before the numbers.</p>
        </div>
        <div class="tool-grid">
          <a class="tool-card primary" href="#tool-sentinel">
            <span class="tool-icon">📊</span>
            <strong>Price Microsoft Sentinel</strong>
            <span>Paste SIEM volume or estimate from inventory, then tune regions, retention, benefits, and exports.</span>
          </a>
          <a class="tool-card" href="#tool-competitor-compare">
            <span class="tool-icon">⚖️</span>
            <strong>Compare SIEM providers</strong>
            <span>Use one GB/day number to compare Sentinel against common public list-rate baselines.</span>
          </a>
          <a class="tool-card" href="#tool-defender-p2">
            <span class="tool-icon">🧮</span>
            <strong>Defender P2 ingestion benefit</strong>
            <span>Run the KQL, paste one result row, and generate a customer-ready PDF report.</span>
          </a>
          <a class="tool-card" href="#tool-defender">
            <span class="tool-icon">🛡️</span>
            <strong>Defender for Cloud plans</strong>
            <span>Estimate protected-resource cost before enabling plans across servers, storage, apps, and more.</span>
          </a>
          <a class="tool-card" href="#tool-quota">
            <span class="tool-icon">📈</span>
            <strong>Usage health</strong>
            <span>Track limits and thresholds so a planning estimate can become an operating conversation.</span>
          </a>
        </div>
      </div>
    </section>

    <section class="tool-workbench">
      <div class="container">
        <CalculatorTabs client:load />
      </div>
    </section>

    <section class="help-section section">
      <div class="container">
        <div class="help-panel">
          <div>
            <span class="eyebrow">Plain-language guardrails</span>
            <h2>Use this for planning, not as an invoice.</h2>
          </div>
          <div class="help-grid">
            <div>
              <h3>Private by default</h3>
              <p>Most calculations run in the browser. AI summaries are optional and clearly separated from deterministic numbers.</p>
            </div>
            <div>
              <h3>Assumptions visible</h3>
              <p>Every tool shows the source volume, public baseline, benefit input, or KQL row behind the estimate.</p>
            </div>
            <div>
              <h3>Customer-ready output</h3>
              <p>The Defender P2 workflow can produce a clean PDF with headers, footers, sources, and use-at-own-risk language.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
